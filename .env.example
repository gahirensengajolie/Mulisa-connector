# Copy to .env and fill in. .env is git-ignored. Never commit real values.

# REQUIRED. The bank's decision when Mulisa cannot answer: fail_open (release) or fail_closed (hold).
# There is no default: the app refuses to start without it.
SCREENING_UNAVAILABLE_POLICY=

# REQUIRED. One API key per calling system, as name=key pairs separated by commas (each >= 16 characters).
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
CONNECTOR_API_KEYS=core-banking=CHANGE_ME_generate_a_long_random_key

# REQUIRED. Where Mulisa is, and the key this connector uses to call it.
MULISA_URL=http://127.0.0.1:9100
MULISA_API_KEY=CHANGE_ME_mulisa_key

# Optional (defaults shown)
MULISA_TIMEOUT_SECONDS=3
MULISA_RETRY_DELAY_SECONDS=0.2
BANK_INSTITUTION_ID=greenbank
BANK_COUNTRY=RW
DATABASE_URL=sqlite:///data/connector.db

# Only used by the local mock (make mock)
MOCK_PORT=9100
MOCK_API_KEY=CHANGE_ME_mulisa_key
