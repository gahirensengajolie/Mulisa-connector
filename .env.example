# Copy to .env and fill in. NEVER commit .env (it is in .gitignore).
# Generate keys with:  python3 -c "import secrets; print(secrets.token_hex(24))"

# REQUIRED. The BANK's decision for when Mulisa cannot answer. No default on purpose:
# the application refuses to start without it.
#   fail_open   = release the payment unscreened
#   fail_closed = hold the payment until it can be screened
SCREENING_UNAVAILABLE_POLICY=

# One key per calling system: name=key,name2=key2   (each key at least 16 characters)
CONNECTOR_API_KEYS=core-banking=CHANGE_ME_generate_a_long_random_key

MULISA_URL=http://localhost:9100        # https only, except localhost
MULISA_API_KEY=CHANGE_ME_the_mulisa_key  # the mock reads the same value as MOCK_API_KEY

MULISA_TIMEOUT_SECONDS=3
MULISA_RETRY_DELAY_SECONDS=0.2

BANK_INSTITUTION_ID=greenbank
BANK_COUNTRY=RW
# Mulisa's transaction.id is unique across ALL banks, so ours is "<prefix>-<reference>".
# Empty = use BANK_INSTITUTION_ID.
TRANSACTION_ID_PREFIX=
MULISA_TRANSACTION_TYPE=transfer
MULISA_CHANNEL=api
MAX_FUTURE_SKEW_SECONDS=300

DATABASE_URL=sqlite:///data/connector.db
ENABLE_API_DOCS=false

# ---- local Mulisa mock (python -m mock_mulisa.server) ----
MOCK_PORT=9100
MOCK_API_KEY=CHANGE_ME_the_mulisa_key
MOCK_FLAG_THRESHOLD_MINOR=1000000
MOCK_BLACKLIST=250722000999,GB-9999
